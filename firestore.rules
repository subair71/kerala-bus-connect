rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    // Public readable so passenger timetables and route cards load seamlessly without login
    match /businesses/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if owns(resource.data);
      allow delete: if owns(resource.data);
    }

    match /routes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if owns(resource.data);
      allow delete: if owns(resource.data);
    }

    match /services/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if owns(resource.data);
      allow delete: if owns(resource.data);
    }
  }
}
