rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }
    match /businesses/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string;
      allow update, delete: if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
    }
    match /routes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid;
      allow update, delete: if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
    }
    match /services/{id} {
      allow read: if resource.data.published == true || owns(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.departureMinutes is int
        && request.resource.data.departureMinutes >= 0
        && request.resource.data.departureMinutes < 1440
        && exists(/databases/$(database)/documents/routes/$(request.resource.data.routeId))
        && get(/databases/$(database)/documents/routes/$(request.resource.data.routeId)).data.ownerId == request.auth.uid;
      allow update: if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if owns(resource.data);
    }
  }
}